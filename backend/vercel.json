{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/gmail",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/v1/cron/airswift",
      "schedule": "30 23 * * *"
    }
  ]
}
